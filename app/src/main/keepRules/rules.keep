# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8

# Keep domain models and navigation/UI contracts
-keep class org.mangoswatch.domain.model.** { *; }
-keep class org.mangoswatch.presentation.contracts.** { *; }
-keep class org.mangoswatch.presentation.viewmodel.** { *; }

# Keep native JNI methods
-keepclassmembers class * {
    native <methods>;
}
